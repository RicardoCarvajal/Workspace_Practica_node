# Local Electron config after Cognito auth (FD Q5=A).
# Secrets (GitLab, AWS, etc.) come from auth-api Secret after login — not from this file.
# Never commit real secrets.
#
# npm run dist also uses only this variable (baked into Main for packaged builds).

# Required: HTTP API base URL (stack output HttpApiUrl)
# Example: AIDLC_CONFIG_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/dev
AIDLC_CONFIG_API_URL=
