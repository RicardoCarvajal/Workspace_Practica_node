{
  "name": "aidlc-ide-inception-view",
  "version": "0.1.0",
  "description": "AIDLC inception view - desktop viewer for GitLab inception docs",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview -- --no-sandbox",
    "dist": "node scripts/prompt-and-build.mjs",
    "dist:ci": "node scripts/prompt-and-build.mjs",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest --pool=forks"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "dotenv": "16.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "0.19.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "fast-check": "3.23.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
